{
  "name": "@learning/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "pack:mac": "pnpm build && electron-builder --mac --dir",
    "pack:win": "pnpm build && electron-builder --win --dir",
    "typecheck": "tsc --noEmit",
    "bundle:win": "pnpm build && electron-builder --win zip --x64",
    "test": "node --test electron/*.test.cjs"
  },
  "dependencies": {
    "@learning/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.4.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "wait-on": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "build": {
    "appId": "dev.learning.notes",
    "productName": "Learning Notes",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record your English speaking practice."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "extraFiles": [
      {
        "from": "learning.config.example.json",
        "to": "learning.config.json"
      }
    ]
  },
  "description": "Personal English learning notes"
}
